# AI Smart Blood Donation Network - Production Environment Configuration
PROJECT_NAME=AI Smart Blood Donation Network
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here

# CORS Configuration
FRONTEND_CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Persistent Storage & Database Configuration
USE_SQLITE_FALLBACK=False
POSTGRES_USER=lifepulse_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lifepulse
# IMPORTANT: pydantic_settings does NOT expand ${VAR} in .env files.
# Write the full literal URL using the values above, e.g.:
# DATABASE_URL=postgresql+asyncpg://lifepulse_user:YOUR_PASSWORD@db:5432/lifepulse
DATABASE_URL=postgresql+asyncpg://lifepulse_user:CHANGE_ME@db:5432/lifepulse
REDIS_URL=redis://redis:6379/0

# Matching Engine Defaults
DEFAULT_MAX_RADIUS_KM=25.0
DEFAULT_RING_SIZE=5
RING_ESCALATION_TIMEOUT_SECONDS=45

# Optional Third-Party Services (Uncomment & fill to connect real services)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# EXOTEL_SID=your_exotel_sid
# EXOTEL_TOKEN=your_exotel_token
# EXOTEL_PHONE_NUMBER=your_exotel_phone_number

# Path to the Firebase service account key file (do not commit the actual JSON file)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
